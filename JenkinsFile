pipeline {
	agent any
	stages {
	    stage ('Initiate tests on BrowserStack') {
	        steps {
    			browserstack(credentialsId: "${credentials}") {
                    sshagent(['dhvani-git']) {
                        sh label: '', returnStatus: true, script: '''#!/bin/bash -l
                            mvn test
                        '''
                    }
                }
	        }
		}
	}
	post {
		always {
			junit 'target/surefire-reports/TEST-*.xml'
			browserStackReportPublisher 'automate'
		}
	}
}